{
  "version": 2,

  "buildCommand": "cd client && pnpm install && pnpm run build",

  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/dist/**",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },

    {
      "src": "/sitemap.xml",
      "dest": "/client/dist/sitemap.xml"
    },

    {
      "src": "/robots.txt",
      "dest": "/client/dist/robots.txt"
    },

    {
      "handle": "filesystem"
    },

    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}