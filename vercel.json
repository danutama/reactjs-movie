{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
  { "src": "/api/(.*)", "dest": "/server/index.js" },
  { "src": "/sw.js", "dest": "/sw.js" },
  { "src": "/workbox-(.*)", "dest": "/workbox-$1" },
  { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
  { "src": "/registerSW.js", "dest": "/registerSW.js" },
  { "src": "/sitemap.xml", "dest": "/client/sitemap.xml" },
{ "src": "/robots.txt", "dest": "/client/robots.txt" },
  { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot))", "dest": "/client/$1" },
  { "src": "/(.*)", "dest": "/client/index.html" }
],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ]
}